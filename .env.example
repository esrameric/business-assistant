# RAG Business Assistant — Ortam Değişkenleri Şablonu
# Bu dosyayı kopyalayıp .env olarak kaydedin ve gerçek değerleri girin.

# ===== Gemini API =====
GEMINI_API_KEY=

# ===== E-posta Ayarları =====
# Gmail kullanıcı adınız
EMAIL_SENDER=
# Gmail uygulama şifresi (https://myaccount.google.com/apppasswords)
EMAIL_PASSWORD=
# SMTP sunucu (Gmail için değiştirmeyin)
EMAIL_SMTP_SERVER=smtp.gmail.com
# SMTP port — SSL için 465, TLS için 587
EMAIL_SMTP_PORT=465
# Raporun gönderileceği alıcı (boş bırakılırsa EMAIL_SENDER'a gönderilir)
EMAIL_RECIPIENT=

# ===== Uygulama =====
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ===== ChromaDB =====
CHROMA_DB_PATH=./chroma_data
